# Copy to .env and fill in. .env is gitignored; it must stay that way.
#
# The sample never reads these -- it fakes every call so it runs anywhere. They
# are here to fix the SHAPE, because the shape is where the mistakes are made.

# Two-legged, for server-to-server work with no user present.
APS_CLIENT_ID=
APS_CLIENT_SECRET=

# Scopes are per LEG, never one blanket grant. The read leg cannot write, and
# only the automation leg gets code:all -- because that scope means "run my code
# on your machines" and a leg that does not need it must not hold it.
APS_SCOPES_DATA_READ=data:read
APS_SCOPES_DERIVATIVE=data:read data:write data:create
APS_SCOPES_AUTOMATION=code:all bucket:create bucket:read

# The nickname owning the Activities in config/activities/. Publish an Activity
# once, reference it by alias forever. A tool exposes an Activity, never a job body.
APS_DA_NICKNAME=

# Where tokens live. Never the process environment in production, and never a
# file next to the code -- that is how a secret reaches a repository.
APS_TOKEN_STORE=dpapi
